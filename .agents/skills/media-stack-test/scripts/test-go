#!/usr/bin/env python3
"""Keep Go test logs on disk and print a bounded outcome summary."""

import json
import subprocess
import sys
from collections import Counter
from tempfile import NamedTemporaryFile


def main(args):
    if not args:
        print("Usage: test-go <go test arguments>", file=sys.stderr)
        return 2

    counts = Counter()
    examples = {"fail": [], "skip": [], "package failure": []}
    with NamedTemporaryFile(
        mode="w", encoding="utf-8", prefix="media-stack-test-", suffix=".log", delete=False
    ) as log:
        print(f"Log: {log.name}", flush=True)
        try:
            process = subprocess.Popen(
                ["go", "test", "-json", *args],
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                encoding="utf-8",
                errors="replace",
            )
        except OSError as error:
            print(error, file=sys.stderr)
            return 2

        with process:
            for line in process.stdout:
                try:
                    event = json.loads(line)
                except json.JSONDecodeError:
                    log.write(line)
                    continue
                if not isinstance(event, dict) or "Action" not in event:
                    log.write(line)
                    continue
                log.write(event.get("Output", ""))

                action = event["Action"]
                test = event.get("Test")
                package = event.get("Package", "")
                if test and action in ("pass", "fail", "skip"):
                    counts[action] += 1
                    name = f"{package} {test}"
                elif not test and action == "fail":
                    action = "package failure"
                    name = package
                else:
                    continue
                if action in examples and len(examples[action]) < 3:
                    examples[action].append(name)
        status = process.returncode

    print(f"Go exit {status} | passed {counts['pass']} | failed {counts['fail']} | skipped {counts['skip']}")
    if status == 0 and not sum(counts.values()):
        print("No tests ran.")
    for action, names in examples.items():
        for name in names:
            print(f"{action}: {name}")
    return status if status >= 0 else 128 - status


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

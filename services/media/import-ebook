#!/usr/bin/env python3
"""Publish one completed EPUB from the Environment's ready directory."""
import argparse
import fcntl
import os
from pathlib import Path
import shutil
import tempfile

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("epub", type=Path, help="path to books/ebooks/ready/<book>.epub")
source = parser.parse_args().epub.absolute()
ready = source.parent
inbox = ready.parent / "inbox"
if ready.name != "ready" or source.suffix.lower() != ".epub" or source.is_symlink() or not source.is_file():
    parser.error("select a completed regular EPUB in the ready directory")
if not inbox.is_dir() or ready.stat().st_dev != inbox.stat().st_dev:
    parser.error("ready and inbox must be sibling directories on one filesystem")

# Stage the copy outside the watcher. Serialize publishers so a second copy
# cannot overwrite a book that is still waiting for Calibre to ingest it.
with tempfile.NamedTemporaryFile(dir=ready, delete=False) as staged:
    temp = Path(staged.name)
try:
    shutil.copyfile(source, temp)
    if temp.stat().st_size == 0:
        parser.error("the EPUB is empty")
    temp.chmod(0o640)
    dest = inbox / source.name
    with (ready / ".publish.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if os.path.lexists(dest):
            parser.error("a copy is already in the inbox")
        temp.rename(dest)
finally:
    temp.unlink(missing_ok=True)
print("Published. Keep the ready source until Calibre-Web shows EPUB and AZW3 on one record.")

# Managed by the homelab Host playbook.
add table inet {{ host_samba_firewall_table }}
flush table inet {{ host_samba_firewall_table }}
table inet {{ host_samba_firewall_table }} {
    chain input {
        type filter hook input priority -10; policy accept;
        ip saddr {{ host_samba_lan }} tcp dport 445 counter accept
        tcp dport 445 counter drop
    }
}
